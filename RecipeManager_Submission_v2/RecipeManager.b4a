	lblHeader.TextSize = 23
	lblHeader.TextColor = darkText
	lblHeader.Typeface = Typeface.DEFAULT_BOLD
	lblHeader.Gravity = Gravity.LEFT
	sv.Panel.AddView(lblHeader, margin, 28dip, cardW, 32dip)

	Dim lblSubtitle As Label
	lblSubtitle.Initialize("")
	lblSubtitle.Text = "Save your favorite meals in one place"
	lblSubtitle.TextSize = 13
	lblSubtitle.TextColor = mutedText
	lblSubtitle.Gravity = Gravity.LEFT
	sv.Panel.AddView(lblSubtitle, margin, 62dip, cardW, 24dip)

	Dim pnlCard As Panel
	pnlCard.Initialize("")
	pnlCard.Background = RoundedBg(Colors.White, 18dip)
	sv.Panel.AddView(pnlCard, margin, 106dip, cardW, 500dip)

	Dim y As Int = 18dip

	lblName.Initialize("")
	lblName.Text = "Recipe name"
	lblName.TextSize = 13
	lblName.TextColor = mutedText
	pnlCard.AddView(lblName, inner, y, inputW, 20dip)

	y = y + 24dip

	txtName.Initialize("txtName")
	txtName.Hint = "Chicken Adobo"
	txtName.SingleLine = True
	txtName.TextSize = 15
	txtName.TextColor = darkText
	txtName.Color = softInput
	txtName.Background = RoundedBg(softInput, 10dip)
	pnlCard.AddView(txtName, inner, y, inputW, 42dip)

	y = y + 56dip

	lblCategory.Initialize("")
	lblCategory.Text = "Category"
	lblCategory.TextSize = 13
	lblCategory.TextColor = mutedText
	pnlCard.AddView(lblCategory, inner, y, inputW, 20dip)

	y = y + 24dip

	spnCategory.Initialize("spnCategory")
	spnCategory.Color = softInput
	AddCategoryItems(spnCategory, False)
	pnlCard.AddView(spnCategory, inner, y, inputW, 42dip)

	y = y + 56dip

	lblIngredients.Initialize("")
	lblIngredients.Text = "Ingredients"
	lblIngredients.TextSize = 13
	lblIngredients.TextColor = mutedText
	pnlCard.AddView(lblIngredients, inner, y, inputW, 20dip)

	y = y + 24dip

	txtIngredients.Initialize("txtIngredients")
	txtIngredients.Hint = "List the ingredients"
	txtIngredients.SingleLine = False
	txtIngredients.Gravity = Gravity.TOP
	txtIngredients.TextSize = 15
	txtIngredients.TextColor = darkText
	txtIngredients.Color = softInput
	txtIngredients.Background = RoundedBg(softInput, 10dip)
	pnlCard.AddView(txtIngredients, inner, y, inputW, 66dip)

	y = y + 80dip

	lblInstructions.Initialize("")
	lblInstructions.Text = "Instructions"
	lblInstructions.TextSize = 13
	lblInstructions.TextColor = mutedText
	pnlCard.AddView(lblInstructions, inner, y, inputW, 20dip)

	y = y + 24dip

	txtInstructions.Initialize("txtInstructions")
	txtInstructions.Hint = "Write the cooking steps"
	txtInstructions.SingleLine = False
	txtInstructions.Gravity = Gravity.TOP
	txtInstructions.TextSize = 15
	txtInstructions.TextColor = darkText
	txtInstructions.Color = softInput
	txtInstructions.Background = RoundedBg(softInput, 10dip)
	pnlCard.AddView(txtInstructions, inner, y, inputW, 78dip)

	y = y + 92dip

	chkFavorite.Initialize("chkFavorite")
	chkFavorite.Text = "Mark as favorite"
	chkFavorite.TextSize = 14
	chkFavorite.TextColor = darkText
	chkFavorite.Checked = False
	pnlCard.AddView(chkFavorite, inner, y, inputW, 36dip)

	y = y + 48dip

	Dim btnGap As Int = 10dip
	Dim btnW As Int = (inputW - (btnGap * 2)) / 3

	btnSave.Initialize("btnSave")
	btnSave.Text = "Save"
	btnSave.TextSize = 14
	btnSave.TextColor = Colors.White
	btnSave.Background = RoundedBg(accent, 12dip)
	pnlCard.AddView(btnSave, inner, y, btnW, 46dip)

	btnDelete.Initialize("btnDelete")
	btnDelete.Text = "Delete"
	btnDelete.TextSize = 14
	btnDelete.TextColor = Colors.RGB(130, 50, 50)
	btnDelete.Background = RoundedBg(Colors.RGB(248, 235, 235), 12dip)
	pnlCard.AddView(btnDelete, inner + btnW + btnGap, y, btnW, 46dip)

	btnClear.Initialize("btnClear")
	btnClear.Text = "Clear"
	btnClear.TextSize = 14
	btnClear.TextColor = Colors.RGB(55, 55, 55)
	btnClear.Background = RoundedBg(Colors.RGB(238, 238, 234), 12dip)
