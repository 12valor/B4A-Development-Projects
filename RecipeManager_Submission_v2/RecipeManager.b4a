Build1=Default,com.school.recipemanager
File1=layout.bal
FileGroup1=Default Group
Group=Default Group
Library1=core
Library2=xui
Library3=sql
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
Module1=Starter
NumberOfFiles=1
NumberOfLibraries=3
NumberOfModules=1
Version=13.4
@EndOfDesignText@
#Region  Project Attributes 
	#ApplicationLabel: Recipe Manager
	#VersionCode: 1
	#VersionName: 1.0
	#SupportedOrientations: portrait
	#CanInstallToExternalStorage: False
#End Region

#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: False
#End Region

Sub Process_Globals
	Private SQL1 As SQL
	Private xui As XUI
	Private SelectedRecipeId As Int = -1
End Sub

Sub Globals
	Private sv As ScrollView
	Private pnlList As Panel

	Private lblHeader As Label
	Private lblName As Label
	Private lblCategory As Label
	Private lblIngredients As Label
	Private lblInstructions As Label
	Private lblList As Label

	Private txtName As EditText
	Private txtIngredients As EditText
	Private txtInstructions As EditText
	Private txtSearch As EditText

	Private spnCategory As Spinner
	Private spnFilter As Spinner
	Private chkFavorite As CheckBox

	Private btnSave As Button
	Private btnDelete As Button
	Private btnClear As Button

	Private lvRecipes As ListView
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.Color = Colors.RGB(247, 246, 242)

	If FirstTime Then
		SetupDatabase
	End If

	BuildLayout
	LoadRecipes
	ClearForm
End Sub

Sub Activity_Resume
	LoadRecipes
End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Private Sub SetupDatabase
	If SQL1.IsInitialized = False Then
		SQL1.Initialize(File.DirInternal, "recipes.db", True)
	End If

	SQL1.ExecNonQuery("CREATE TABLE IF NOT EXISTS recipes (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, ingredients TEXT, instructions TEXT, category TEXT DEFAULT 'Other', is_favorite INTEGER DEFAULT 0)")

	EnsureColumn("recipes", "category", "category TEXT DEFAULT 'Other'")
	EnsureColumn("recipes", "is_favorite", "is_favorite INTEGER DEFAULT 0")

	NormalizeOldRows
	SeedRecipesIfEmpty
End Sub

Private Sub EnsureColumn(TableName As String, ColumnName As String, ColumnDefinition As String)
	Dim found As Boolean = False
	Dim rs As Cursor = SQL1.ExecQuery("PRAGMA table_info(" & TableName & ")")

	For i = 0 To rs.RowCount - 1
		rs.Position = i

		If rs.GetString("name").ToLowerCase = ColumnName.ToLowerCase Then
			found = True
			Exit
		End If
	Next

	rs.Close

	If found = False Then
		SQL1.ExecNonQuery("ALTER TABLE " & TableName & " ADD COLUMN " & ColumnDefinition)
	End If
End Sub

Private Sub NormalizeOldRows
	SQL1.ExecNonQuery("UPDATE recipes SET category = 'Other' WHERE category IS NULL OR category = ''")
	SQL1.ExecNonQuery("UPDATE recipes SET is_favorite = 0 WHERE is_favorite IS NULL")
End Sub

Private Sub SeedRecipesIfEmpty
	Dim rs As Cursor = SQL1.ExecQuery("SELECT COUNT(*) AS total FROM recipes")
	rs.Position = 0

	If rs.GetInt("total") = 0 Then
		SQL1.ExecNonQuery2("INSERT INTO recipes (name, ingredients, instructions, category, is_favorite) VALUES (?, ?, ?, ?, ?)", _
			Array As Object("Chicken Adobo", "Chicken, soy sauce, vinegar, garlic, bay leaf, pepper", "Marinate chicken. Simmer with soy sauce, vinegar, garlic, bay leaf, and pepper until tender.", "Dinner", 1))

		SQL1.ExecNonQuery2("INSERT INTO recipes (name, ingredients, instructions, category, is_favorite) VALUES (?, ?, ?, ?, ?)", _
			Array As Object("Garlic Fried Rice", "Cooked rice, garlic, oil, salt", "Toast garlic in oil. Add rice and salt. Stir fry until hot.", "Breakfast", 0))

		SQL1.ExecNonQuery2("INSERT INTO recipes (name, ingredients, instructions, category, is_favorite) VALUES (?, ?, ?, ?, ?)", _
			Array As Object("Mango Float", "Graham crackers, cream, condensed milk, mangoes", "Layer crackers, sweet cream, and mango slices. Chill before serving.", "Dessert", 1))
	End If

	rs.Close
End Sub

Private Sub BuildLayout
