	Activity.Color = Colors.RGB(247, 246, 242)

	Dim margin As Int = 16dip
	Dim pageW As Int = 100%x
	Dim cardW As Int = pageW - (margin * 2)
	Dim inner As Int = 16dip
	Dim inputW As Int = cardW - (inner * 2)

	Dim darkText As Int = Colors.RGB(25, 25, 25)
	Dim mutedText As Int = Colors.RGB(95, 95, 95)
	Dim accent As Int = Colors.RGB(39, 103, 80)
	Dim softInput As Int = Colors.RGB(250, 250, 248)
	Dim lineColor As Int = Colors.RGB(232, 232, 228)

	sv.Initialize(1200dip)
	Activity.AddView(sv, 0, 0, 100%x, 100%y)
	sv.Panel.Color = Colors.RGB(247, 246, 242)

	Dim topBar As Panel
	topBar.Initialize("")
	topBar.Color = accent
	sv.Panel.AddView(topBar, 0, 0, 100%x, 5dip)

	lblHeader.Initialize("")
