	txtSearch.SingleLine = True
	txtSearch.TextSize = 15
	txtSearch.TextColor = darkText
	txtSearch.Color = softInput
	txtSearch.Background = RoundedBg(softInput, 10dip)
	pnlList.AddView(txtSearch, inner, 86dip, inputW, 42dip)

	spnFilter.Initialize("spnFilter")
	spnFilter.Color = softInput
	AddCategoryItems(spnFilter, True)
	pnlList.AddView(spnFilter, inner, 140dip, inputW, 42dip)

	Dim divider As Panel
	divider.Initialize("")
	divider.Color = lineColor
	pnlList.AddView(divider, inner, 196dip, inputW, 1dip)

	lvRecipes.Initialize("lvRecipes")
	lvRecipes.Color = Colors.White
	lvRecipes.SingleLineLayout.ItemHeight = 52dip
	lvRecipes.SingleLineLayout.Label.TextSize = 15
	lvRecipes.SingleLineLayout.Label.TextColor = darkText
	pnlList.AddView(lvRecipes, inner, 210dip, inputW, 180dip)

	sv.Panel.Height = 1060dip
End Sub

Private Sub RoundedBg(BgColor As Int, Radius As Int) As ColorDrawable
	Dim cd As ColorDrawable
	cd.Initialize(BgColor, Radius)
	Return cd
End Sub

Private Sub AddCategoryItems(spn As Spinner, IncludeAll As Boolean)
	spn.Clear

	If IncludeAll Then
		spn.Add("All Categories")
	End If

	spn.Add("Breakfast")
	spn.Add("Lunch")
	spn.Add("Dinner")
	spn.Add("Dessert")
	spn.Add("Snack")
	spn.Add("Other")
End Sub

Private Sub GetSelectedCategory As String
	If spnCategory.IsInitialized = False Then Return "Other"
	If spnCategory.SelectedIndex < 0 Then Return "Other"

	Return spnCategory.GetItem(spnCategory.SelectedIndex)
End Sub

Private Sub SetCategorySpinner(CategoryName As String)
	If spnCategory.IsInitialized = False Then Return

	If CategoryName = "" Then
		CategoryName = "Other"
	End If

	For i = 0 To spnCategory.Size - 1
		If spnCategory.GetItem(i) = CategoryName Then
			spnCategory.SelectedIndex = i
			Return
		End If
	Next

	spnCategory.SelectedIndex = spnCategory.Size - 1
End Sub

Private Sub ListToStringArray(Items As List) As String()
	Dim arr(Items.Size) As String

	For i = 0 To Items.Size - 1
		arr(i) = "" & Items.Get(i)
	Next

	Return arr
End Sub

Private Sub ResetListFilters
	If txtSearch.IsInitialized Then
		txtSearch.Text = ""
	End If

	If spnFilter.IsInitialized Then
		spnFilter.SelectedIndex = 0
	End If
End Sub

Private Sub ResizeRecipeList
	If lvRecipes.IsInitialized = False Then Return
	If pnlList.IsInitialized = False Then Return
	If sv.IsInitialized = False Then Return

	Dim itemH As Int = 52dip
	Dim newListH As Int = lvRecipes.Size * itemH

	If newListH < 180dip Then
		newListH = 180dip
	End If

	lvRecipes.Height = newListH
	pnlList.Height = 230dip + newListH
	sv.Panel.Height = 626dip + pnlList.Height + 30dip
End Sub

Private Sub LoadRecipes
	If SQL1.IsInitialized = False Then Return
	If lvRecipes.IsInitialized = False Then Return

	lvRecipes.Clear

	Dim sqlQuery As String = "SELECT id, name, IFNULL(category, 'Other') AS category, IFNULL(is_favorite, 0) AS is_favorite FROM recipes WHERE 1 = 1"
	Dim args As List
	args.Initialize

	If txtSearch.IsInitialized Then
		Dim keyword As String = txtSearch.Text.Trim

		If keyword <> "" Then
			sqlQuery = sqlQuery & " AND name LIKE ?"
			args.Add("%" & keyword & "%")
		End If
	End If

	If spnFilter.IsInitialized Then
		If spnFilter.SelectedIndex > 0 Then
			sqlQuery = sqlQuery & " AND IFNULL(category, 'Other') = ?"
			args.Add(spnFilter.GetItem(spnFilter.SelectedIndex))
		End If
	End If

	sqlQuery = sqlQuery & " ORDER BY IFNULL(is_favorite, 0) DESC, name COLLATE NOCASE"

	Dim rs As Cursor

	If args.Size = 0 Then
		rs = SQL1.ExecQuery(sqlQuery)
	Else
		rs = SQL1.ExecQuery2(sqlQuery, ListToStringArray(args))
	End If

	For i = 0 To rs.RowCount - 1
		rs.Position = i

		Dim recipeName As String = rs.GetString("name")
		Dim category As String = rs.GetString("category")
		Dim isFavorite As Int = rs.GetInt("is_favorite")

		Dim displayText As String = recipeName

		If isFavorite = 1 Then
			displayText = "★ " & displayText
		End If

		If category <> "" Then
			displayText = displayText & "  ·  " & category
		End If

		lvRecipes.AddSingleLine2(displayText, rs.GetInt("id"))
	Next

	rs.Close

	If lvRecipes.Size = 0 Then
		lvRecipes.AddSingleLine2("No recipes found.", -1)
	End If

	ResizeRecipeList
End Sub

Private Sub ClearForm
	SelectedRecipeId = -1

	txtName.Text = ""
	txtIngredients.Text = ""
	txtInstructions.Text = ""

	If spnCategory.IsInitialized Then
		spnCategory.SelectedIndex = 5
	End If

	If chkFavorite.IsInitialized Then
		chkFavorite.Checked = False
	End If

	btnSave.Text = "Save"
End Sub

Sub btnSave_Click
	Dim recipeName As String = txtName.Text.Trim
	Dim ingredients As String = txtIngredients.Text.Trim
	Dim instructions As String = txtInstructions.Text.Trim
	Dim category As String = GetSelectedCategory

	If recipeName = "" Or ingredients = "" Or instructions = "" Then
		xui.MsgboxAsync("Please complete all fields before saving.", "Missing Information")
		Return
	End If

	Dim favoriteValue As Int = 0

	If chkFavorite.Checked Then
		favoriteValue = 1
	End If

	If SelectedRecipeId = -1 Then
		SQL1.ExecNonQuery2("INSERT INTO recipes (name, ingredients, instructions, category, is_favorite) VALUES (?, ?, ?, ?, ?)", _
			Array As Object(recipeName, ingredients, instructions, category, favoriteValue))

		ToastMessageShow("Recipe added.", False)
	Else
		SQL1.ExecNonQuery2("UPDATE recipes SET name = ?, ingredients = ?, instructions = ?, category = ?, is_favorite = ? WHERE id = ?", _
			Array As Object(recipeName, ingredients, instructions, category, favoriteValue, SelectedRecipeId))

		ToastMessageShow("Recipe updated.", False)
	End If

	ResetListFilters
	LoadRecipes
	ClearForm
End Sub

Sub btnDelete_Click
	If SelectedRecipeId = -1 Then
		xui.MsgboxAsync("Select a recipe from the list first.", "Nothing Selected")
		Return
	End If

	Dim sf As Object = xui.Msgbox2Async("Are you sure you want to delete this recipe?", "Confirm Delete", "Delete", "Cancel", "", Null)
	Wait For (sf) Msgbox_Result (Result As Int)

	If Result = xui.DialogResponse_Positive Then
		SQL1.ExecNonQuery2("DELETE FROM recipes WHERE id = ?", Array As Object(SelectedRecipeId))

		ToastMessageShow("Recipe deleted.", False)

		ResetListFilters
		LoadRecipes
		ClearForm
	End If
End Sub

Sub btnClear_Click
	ClearForm
End Sub

Sub txtSearch_TextChanged (Old As String, New As String)
	LoadRecipes
End Sub

Sub spnFilter_ItemClick (Position As Int, Value As Object)
	LoadRecipes
End Sub

Sub lvRecipes_ItemClick (Position As Int, Value As Object)
	Dim recipeId As Int = Value

	If recipeId = -1 Then Return

	SelectedRecipeId = recipeId

	Dim rs As Cursor
	rs = SQL1.ExecQuery2("SELECT name, ingredients, instructions, IFNULL(category, 'Other') AS category, IFNULL(is_favorite, 0) AS is_favorite FROM recipes WHERE id = ?", Array As String("" & recipeId))

	If rs.RowCount > 0 Then
		rs.Position = 0

		txtName.Text = rs.GetString("name")
		txtIngredients.Text = rs.GetString("ingredients")
		txtInstructions.Text = rs.GetString("instructions")

		SetCategorySpinner(rs.GetString("category"))

		If rs.GetInt("is_favorite") = 1 Then
			chkFavorite.Checked = True
		Else
			chkFavorite.Checked = False
		End If

		btnSave.Text = "Update"
	End If

	rs.Close
End Sub